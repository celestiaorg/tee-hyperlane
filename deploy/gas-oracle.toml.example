# What a Celestia-origin transfer is charged for gas on the far side. `teeism config` writes the
# live file, devnet/.state/gas-oracle.toml, from the deployment; this is its shape.
#
# Once an hour is enough. The quote only has to be close enough that the relayer is not
# systematically underpaid; between rounds the paymaster keeps the last values.
interval_secs = 3600

# The paymaster on Celestia, owned by the `bridge` key the oracle signs as (`teeism paymaster`).
igp_id = "0x726f757465725f706f73745f6469737061746368000000040000000000000002"
celestia_rpc = "http://localhost:26657"
chain_id = "teeism-local"
local_price_id = "celestia"

[[destinations]]
name = "Ethereum Sepolia"
domain = 11155111
rpc = "https://ethereum-sepolia-rpc.publicnode.com"
decimals = 18
price_id = "ethereum"
# Measured: mailbox.process cost 89k to 127k across this deployment's transfers.
gas_overhead = 150000

[[destinations]]
name = "Arbitrum Sepolia"
domain = 421614
rpc = "https://arbitrum-sepolia-rpc.publicnode.com"
decimals = 18
price_id = "ethereum"
gas_overhead = 150000

[[destinations]]
name = "Base Sepolia"
domain = 84532
rpc = "https://base-sepolia-rpc.publicnode.com"
decimals = 18
price_id = "ethereum"
gas_overhead = 150000

# Eden pays gas in TIA, so its price id is the local one and the ratio posted is one.
[[destinations]]
name = "Eden"
domain = 3735928814
rpc = "https://rpc.testnet.eden.gateway.fm/"
decimals = 18
price_id = "celestia"
gas_overhead = 150000
