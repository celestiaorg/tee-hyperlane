# The ark deployment: eight routes, three enclaves, no proving anywhere. This is the live
# file verbatim, with the one metered key replaced by a placeholder.
#
# attest_only is what makes this the non-ZK stack: the enclave's quote travels to the
# destination as-is and the destination verifies it, so nothing sits between attesting and
# submitting. The ZK deployment this replaced needed two SP1 Groth16 proofs per batch here.
tick_secs = 2
celestia_lag = 1
proof_dir = "/home/chef/tee-ism-nonzk/devnet/.state/proofs"

[[routes]]
name = "celestia-to-sepolia"
tee_node_url = "https://6cc58f925581ff5ec3f76ed78fa31e692c2c4257-8080.dstack-pha-prod9.phala.network"
ism_id = "0x83B41448ADfBdde1926575f774489892F88190A8"
merkle_tree_address = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
attest_only = true
routers = ["0x9822eE81C82138F88D759faef1AC168aDfEe1467", "0xfb611B6f6CE92033960e99C2D65cee4237e64cDD"]

[routes.origin]
kind = "celestia"
domain = 1297040299
rpc = "http://localhost:26657"
grpc = "http://localhost:9090"
mailbox_id = "0x68797065726c616e650000000000000000000000000000000000000000000000"
merkle_tree_hook_id = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
ism_module = "teeism"

[routes.destination]
kind = "ethereum"
domain = 11155111
execution_rpc = "https://rpc.sepolia.ethpandaops.io"
mailbox = "0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766"

