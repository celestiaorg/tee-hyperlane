[[routes]]
name = "base-to-celestia"
tee_node_url = "https://08640d25537e738670397ba12576315575b345e1-8080.dstack-pha-prod9.phala.network"
ism_id = "0x726f757465725f69736d000000000000000000000000002b000000000000000f"
merkle_tree_address = "0x00000000000000000000000086fb9f1c124fb20ff130c41a79a432f770f67afd"
attest_only = true
routers = ["0x726f757465725f61707000000000000000000000000000010000000000000000", "0x726f757465725f61707000000000000000000000000000020000000000000001"]

[routes.origin]
kind = "ethereum_l2"
domain = 84532
rollup = "base"
# The one field in this file that needs a paid endpoint. Base's confirmed head trails by the
# five day dispute window, roughly 220k blocks, and no free endpoint serves eth_getProof that
# far back; Base's own RPC does not serve the method at all. A free Alchemy tier is enough.
# Keep the key in .state/alchemy-base-key and substitute it here, never commit it.
l2_rpc = "https://base-sepolia.g.alchemy.com/v2/ALCHEMY_BASE_KEY"
# Logs go somewhere else on purpose: Alchemy's free tier caps eth_getLogs at ten blocks and a
# confirmed L2 head moves thousands at a time; this one serves the whole span. Both untrusted.
logs_rpc = "https://sepolia.base.org"
l1_anchor_contract = "0x2fF5cC82dBf333Ea30D8ee462178ab1707315355"
mailbox = "0x6966b0E55883d49BFB24539356a2f8A673E02039"
merkle_tree_hook = "0x86fb9F1c124fB20ff130C41a79a432F770f67AFD"
merkle_tree_base_slot = 151

[routes.origin.l1]
kind = "ethereum"
domain = 11155111
execution_rpc = "https://rpc.sepolia.ethpandaops.io"
beacon_rpc = "https://ethereum-sepolia-beacon-api.publicnode.com"
mailbox = "0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766"

[routes.destination]
kind = "celestia"
domain = 1297040299
rpc = "http://localhost:26657"
grpc = "http://localhost:9090"
mailbox_id = "0x68797065726c616e650000000000000000000000000000000000000000000000"
merkle_tree_hook_id = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
ism_module = "teeism"

# Eden is an evolve-stack chain, so its origin is neither `ethereum` nor `ethereum_l2`: there
# is no L1 anchor to prove against. `celestia_l2` verifies the sequencer's signature over a
# header published to Celestia as a blob, against a Celestia light client in the enclave.
[[routes]]
name = "eden-to-celestia"
tee_node_url = "https://8a28d356d8546472fdf9bc4318e1538b5140e83e-8080.dstack-pha-prod9.phala.network"
ism_id = "0x726f757465725f69736d000000000000000000000000002b0000000000000010"
merkle_tree_address = "0x000000000000000000000000cfbe7016d123d52a7db4fc7d087ccb5421dbf8db"
attest_only = true
routers = ["0x726f757465725f61707000000000000000000000000000010000000000000000", "0x726f757465725f61707000000000000000000000000000020000000000000001"]

[routes.origin]
kind = "celestia_l2"
domain = 3735928814
rollup = "eden"
# Serves eth_getProof, but only at the `latest` tag, which is why the relayer captures tree
# proofs ahead of the header that will justify them and spends them once DA catches up.
l2_rpc = "https://ev-reth-eden-testnet.binarybuilders.services:8545/"
# The public endpoint, which serves logs but not proofs. Both are untrusted.
logs_rpc = "https://rpc.testnet.eden.gateway.fm/"
da_rpc = "http://localhost:26658"
mailbox = "0x1D32350f3440BEa7f7E450Aa085f63E0d7E38729"
merkle_tree_hook = "0xCfBE7016D123d52A7Db4fc7D087cCb5421dbF8db"
merkle_tree_base_slot = 151

# Eden posts its signed headers to mocha, not to our own chain, so this light client is a
# second one: mocha's, not teeism-local's.
[routes.origin.celestia]
kind = "celestia"
domain = 1297040200
rpc = "https://rpc-mocha.pops.one"
grpc = "https://grpc-mocha.pops.one"
mailbox_id = "0x68797065726c616e650000000000000000000000000000000000000000000000"
merkle_tree_hook_id = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
ism_module = "teeism"

[routes.destination]
kind = "celestia"
domain = 1297040299
rpc = "http://localhost:26657"
grpc = "http://localhost:9090"
mailbox_id = "0x68797065726c616e650000000000000000000000000000000000000000000000"
merkle_tree_hook_id = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
ism_module = "teeism"
