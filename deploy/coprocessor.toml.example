kind = "ethereum_l2"
domain = 421614
rollup = "arbitrum"
l2_rpc = "https://api.zan.top/arb-sepolia"
# Logs come from a second endpoint on purpose: a confirmed L2 head moves thousands of blocks
# at a time and this one serves the whole span in one eth_getLogs. Both are untrusted.
logs_rpc = "https://arbitrum-sepolia-rpc.publicnode.com"
l1_anchor_contract = "0x042B2E6C5E99d4c521bd49beeD5E99651D9B0Cf4"
mailbox = "0x598facE78a4302f11E3de0bee1894Da0b2Cb71F8"
merkle_tree_hook = "0xAD34A66Bf6dB18E858F6B686557075568c6E031C"
