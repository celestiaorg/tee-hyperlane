# The ark deployment: five origins, eight routes, one shared CVM running an enclave per origin.
# `teeism config` writes the live file from devnet/.state/deployment.json.
#
# Chains are declared once and routes name them. A chain's fields are documented on its
# `Config` in tee-hyperlane/crates/tee-coprocessor/src/origin/{l1,l2}/<chain>.rs. This is the
# live file with the one metered key replaced; refresh it after a re-deployment:
#
#   ssh chef@ark 'cat ~/tee-ism-nonzk/devnet/.state/coprocessor.toml' \
#     | sed 's|/v2/[A-Za-z0-9_-]*|/v2/ALCHEMY_KEY|' > deploy/coprocessor.toml.example

tick_secs = 2
proof_dir = "/home/chef/tee-ism-nonzk/devnet/.state/proofs"
api_listen = "0.0.0.0:3001"

[faucet]
chain = "celestia"
key = "user"
grants = [
  { symbol = "TIA", denom = "utia", amount = 5000000000, floor = 500000000000000 },
  { symbol = "teeUSD", denom = "hyperlane/0x726f757465725f61707000000000000000000000000000020000000000000001", amount = 20000000000, floor = 1000000000000000 },
]

# ---------------------------------------------------------------- chains

# The local Celestia devnet: origin of four routes, destination of four.
[chains.celestia]
kind = "celestia"
domain = 1297040299
rpc = "http://localhost:26657"
mailbox = "0x68797065726c616e650000000000000000000000000000000000000000000000"
merkle_tree_hook = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
lag = 1
chain_id = "teeism-local"
home = "/home/chef/tee-ism-nonzk/devnet/.state/celestia"

# Mocha, read only as the chain Eden posts its headers to.
[chains.mocha]
kind = "celestia"
domain = 1297040200
rpc = "https://rpc.celestia-mocha.com"

[chains.sepolia]
kind = "ethereum"
domain = 11155111
rpc = "http://127.0.0.1:8545"
beacon_rpc = "http://127.0.0.1:9596"
mailbox = "0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766"
merkle_tree_hook = "0x4917a9746A7B6E0A57159cCb7F5a6744247f2d0d"

# Arbitrum and Base are attested from blocks their sequencer signed: Arbitrum's from its feed,
# Base's from the OP Stack p2p network. `rpc` is the one metered endpoint for each (Alchemy,
# key ALCHEMY_KEY in devnet/.env; never commit it): it is read only at the ISM's trusted height,
# which can be old. Logs and reads near the head go to the free endpoint.
[chains.arbitrum]
kind = "arbitrum"
domain = 421614
rpc = "https://arb-sepolia.g.alchemy.com/v2/ALCHEMY_KEY"
feed = "wss://sepolia-rollup.arbitrum.io/feed"
logs_rpc = "https://sepolia-rollup.arbitrum.io/rpc"
send_rpc = "https://sepolia-rollup.arbitrum.io/rpc"
mailbox = "0x598facE78a4302f11E3de0bee1894Da0b2Cb71F8"
merkle_tree_hook = "0xAD34A66Bf6dB18E858F6B686557075568c6E031C"

[chains.base]
kind = "base"
domain = 84532
rpc = "https://base-sepolia.g.alchemy.com/v2/ALCHEMY_KEY"
p2p_port = 9222
logs_rpc = "https://sepolia.base.org"
send_rpc = "https://sepolia.base.org"
mailbox = "0x6966b0E55883d49BFB24539356a2f8A673E02039"
merkle_tree_hook = "0x86fb9F1c124fB20ff130C41a79a432F770f67AFD"

[chains.eden]
kind = "eden"
domain = 3735928814
celestia = "mocha"
da_rpc = "http://localhost:26658"
rpc = "https://ev-reth-eden-testnet.binarybuilders.services:8545/"
logs_rpc = "https://rpc.testnet.eden.gateway.fm/"
send_rpc = "https://rpc.testnet.eden.gateway.fm/"
mailbox = "0x4D37EeeAE9fA656a85D15366f60dc55aa73a1907"
merkle_tree_hook = "0xDF59A3c135B159a7Ac81b0140425C3B4Ba0407a9"

# ---------------------------------------------------------------- routes
#
# Every enclave URL is `https://<app id>-<port>.<gateway>`, both as `teeism enclaves up` read
# them from Phala for the shared CVM.
#
# `routers` are our warp routers on the destination: only a batch carrying a message for one
# of them starts an attestation. It changes when a route works, never what it delivers.

# Attested by the celestia enclave, port 8080 of the shared CVM.
[[routes]]
name = "celestia-to-sepolia"
from = "celestia"
to = "sepolia"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8080.dstack-pha-prod9.phala.network"
ism = "0x8DDAB7d98b7C7FC40eb4D54Ae10Da60734f2c5AF"
routers = ["0x7F751c18467C6D00f423BBc8183C38B01898D07c", "0xB2fab15FdC9185b6F15eB383fe57E12cc7Ea5e99"]

[[routes]]
name = "celestia-to-arbitrum"
from = "celestia"
to = "arbitrum"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8080.dstack-pha-prod9.phala.network"
ism = "0xE7eAeb624AB993f2b058E041dd2b762a9F0c038B"
routers = ["0xDED207d4d9fad5aC89E755D77029453fFa834F2f", "0xE7d728A1884C840b4153A0BcAb766e8ebb5352dF"]

[[routes]]
name = "celestia-to-base"
from = "celestia"
to = "base"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8080.dstack-pha-prod9.phala.network"
ism = "0x96D3A82398545651117e0B754b55a2cF00A0aA1c"
routers = ["0x5F37c2B101527997436de2BB7C8636B356621d7b", "0xdA22F5ebE5e8dF2cbA5a4487622B9EF80BA413e7"]

[[routes]]
name = "celestia-to-eden"
from = "celestia"
to = "eden"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8080.dstack-pha-prod9.phala.network"
ism = "0xB06dE0F56E05f5af1431708af6B92888d18A9abd"
routers = ["0xad4471aC85d64E6ea99426EedCB15097EF3EC850", "0x254Fd6b521ac0f6911Ef10846D6fc932D9ed3191"]

# Attested by the ethereum, arbitrum and base enclaves, ports 8081, 8083 and 8082.
[[routes]]
name = "sepolia-to-celestia"
from = "sepolia"
to = "celestia"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8081.dstack-pha-prod9.phala.network"
ism = "0x726f757465725f69736d000000000000000000000000002b0000000000000001"
routers = ["0x726f757465725f61707000000000000000000000000000010000000000000000", "0x726f757465725f61707000000000000000000000000000020000000000000001"]
max_lag = 300

[[routes]]
name = "arbitrum-to-celestia"
from = "arbitrum"
to = "celestia"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8083.dstack-pha-prod9.phala.network"
ism = "0x726f757465725f69736d000000000000000000000000002b0000000000000005"
routers = ["0x726f757465725f61707000000000000000000000000000010000000000000000", "0x726f757465725f61707000000000000000000000000000020000000000000001"]

[[routes]]
name = "base-to-celestia"
from = "base"
to = "celestia"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8082.dstack-pha-prod9.phala.network"
ism = "0x726f757465725f69736d000000000000000000000000002b0000000000000002"
routers = ["0x726f757465725f61707000000000000000000000000000010000000000000000", "0x726f757465725f61707000000000000000000000000000020000000000000001"]

# Attested by the eden enclave, port 8084.
[[routes]]
name = "eden-to-celestia"
from = "eden"
to = "celestia"
enclave = "https://fcdc75f95d37f0fbccc410b66d51aaf95e13c404-8084.dstack-pha-prod9.phala.network"
ism = "0x726f757465725f69736d000000000000000000000000002b0000000000000003"
routers = ["0x726f757465725f61707000000000000000000000000000010000000000000000", "0x726f757465725f61707000000000000000000000000000020000000000000001"]
