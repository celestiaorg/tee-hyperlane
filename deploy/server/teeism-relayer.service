[Unit]
Description=TEE ISM coprocessor: every route, and the dashboard API on 127.0.0.1:3001
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=chef
WorkingDirectory=/home/chef/tee-ism-nonzk
Environment=HOME=/home/chef
# cast signs EVM transactions, celestia-appd Celestia ones, teeism-collateral fetches Intel's
# collateral for the Celestia ISM. Chain endpoints, keys' homes and chain ids are in the config.
Environment=PATH=/home/chef/tee-ism-nonzk/devnet/.state/bin:/home/chef/.foundry/bin:/usr/local/bin:/usr/bin:/bin
Environment=APPD=/home/chef/tee-ism-nonzk/devnet/.state/bin/celestia-appd
Environment=COLLATERAL_BIN=/home/chef/tee-ism-nonzk/devnet/.state/bin/teeism-collateral
Environment=RUST_LOG=info
# EVM_PRIVATE_KEY, the relayer's key on every EVM chain.
EnvironmentFile=/home/chef/tee-ism-nonzk/devnet/.env
ExecStart=/home/chef/tee-ism-nonzk/tee-hyperlane/target/release/tee-hyperlane --config /home/chef/tee-ism-nonzk/devnet/.state/coprocessor.toml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
