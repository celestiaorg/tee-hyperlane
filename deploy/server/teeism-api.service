[Unit]
Description=TEE ISM attestation API (serves the bridge UI)
After=network-online.target teeism-relayer.service
Wants=network-online.target

[Service]
Type=simple
User=chef
WorkingDirectory=/home/chef/tee-ism-nonzk
Environment=HOME=/home/chef
Environment=PATH=/home/chef/tee-ism-nonzk/devnet/.state/bin:/home/chef/.foundry/bin:/usr/local/go/bin:/home/chef/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_LOG=info
# The faucet signs with celestia-appd, like the relayer does. Without CELHOME the
# endpoint reports itself unconfigured rather than failing per request.
Environment=APPD=/home/chef/tee-ism-nonzk/devnet/.state/bin/celestia-appd
Environment=CELHOME=/home/chef/tee-ism-nonzk/devnet/.state/celestia
Environment=CELESTIA_CHAIN_ID=teeism-local
Environment=CELESTIA_RPC=http://localhost:26657
Environment=FAUCET_KEY=faucet
ExecStart=/home/chef/tee-ism-nonzk/tee-hyperlane/target/release/tee-hyperlane \
  --config /home/chef/tee-ism-nonzk/devnet/.state/coprocessor.toml \
  serve --listen 0.0.0.0:3001 --proof-dir /home/chef/tee-ism-nonzk/devnet/.state/proofs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
